#!/bin/bash
#BSUB -q Batch72
#BSUB -n 16
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=24000]"
#BSUB -J exp_smoke_posthoc
#BSUB -oo /scratch/sima9999/modal_uq/schwabach/exp_smoke_posthoc_%J.log
#BSUB -eo /scratch/sima9999/modal_uq/schwabach/exp_smoke_posthoc_%J.err
#BSUB -L /usr/bin/bash
export PYTHONPATH=$HOME/git_cs2redo/uq_oma_b:$HOME/git_cs2redo/PolyUQ:$HOME/git_cs2redo/pyOMA
export SCHWABACH_DIR=$HOME/scratch/modal_uq/2019_Schwabach
export POLYUQ_JOB_ID=$LSB_JOBID
# NOT pinned to 1: this driver runs no process pool, and the per-sample cost is
# a threaded-BLAS SVD/pinv chain, so the slots are used inside the linear algebra
export OMP_NUM_THREADS=16
export OPENBLAS_NUM_THREADS=16
export MKL_NUM_THREADS=16
$HOME/conda/envs/py311/bin/python $HOME/git_cs2redo/uq_oma_b/pyoma_uq/cluster/run_exp_cluster.py \
  --weighting posthoc \
  --result-dir /scratch/sima9999/modal_uq/schwabach/exp_smoke \
  --state /scratch/sima9999/modal_uq/schwabach/samp_state_exp_smoke.npz \
  --schwabach $HOME/scratch/modal_uq/2019_Schwabach
